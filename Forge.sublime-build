{
  "selector": "source.forge",
  "cmd": ["forge", "build"],
  "working_dir": "${project_path:${folder:$file_path}}",
  "encoding": "utf-8",
  "variants": [
    {
      "name": "Check File",
      "cmd": ["forge", "$file", "--check"],
      "working_dir": "$file_path"
    },
    {
      "name": "Run Project",
      "cmd": ["forge", "run"]
    }
  ]
}
